# Copy these into Vercel -> Settings -> Environment Variables.
# All three are safe to expose in the browser by design.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# These are NOT for Vercel. They are Supabase Edge Function secrets
# (Supabase -> Edge Functions -> Secrets). Never put the private key in Vercel
# or in any VITE_ variable.
#
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
